<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/n_root" android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:padding="14dp" android:gravity="center_vertical" android:background="@drawable/widget_bg">
    <TextView android:id="@+id/n_title" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:textSize="12sp" android:textColor="#7A8494" android:textStyle="bold" android:maxLines="1" android:ellipsize="end" />
    <TextView android:id="@+id/n_days" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:textSize="30sp" android:textColor="#FF5C9A" android:textStyle="bold" android:includeFontPadding="false" android:layout_marginTop="2dp" />
    <ProgressBar android:id="@+id/n_bar" style="@android:style/Widget.ProgressBar.Horizontal"
        android:layout_width="match_parent" android:layout_height="6dp" android:layout_marginTop="8dp"
        android:max="100" android:progressDrawable="@drawable/widget_progress" />
    <TextView android:id="@+id/n_next" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="5dp"
        android:textSize="11sp" android:textColor="#4F7CFF" android:maxLines="2" android:ellipsize="end" />
</LinearLayout>
