<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/t_root" android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:padding="12dp" android:background="@drawable/widget_bg">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="오늘 · 내일"
            android:textSize="14sp" android:textColor="#1B2230" android:textStyle="bold" />
        <TextView android:id="@+id/t_date" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
            android:gravity="end" android:textSize="11sp" android:textColor="#7A8494" />
    </LinearLayout>
    <TextView android:id="@+id/t_empty" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp"
        android:gravity="center" android:textSize="12sp" android:textColor="#7A8494" android:lineSpacingExtra="3dp" android:visibility="gone" />
    <LinearLayout android:id="@+id/t_row1" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:layout_marginTop="4dp" android:paddingStart="10dp" android:paddingEnd="10dp"
        android:paddingTop="5dp" android:paddingBottom="5dp" android:background="@drawable/widget_row_bg" android:gravity="center_vertical">
        <TextView android:id="@+id/t_row1_k" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="10sp" android:layout_marginEnd="6dp" />
        <TextView android:id="@+id/t_row1_w" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="11sp" android:textStyle="bold" android:layout_marginEnd="8dp" />
        <TextView android:id="@+id/t_row1_t" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
            android:textSize="12sp" android:textColor="#3A4354" android:maxLines="1" android:ellipsize="end" />
    </LinearLayout>
    <LinearLayout android:id="@+id/t_row2" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:layout_marginTop="4dp" android:paddingStart="10dp" android:paddingEnd="10dp"
        android:paddingTop="5dp" android:paddingBottom="5dp" android:background="@drawable/widget_row_bg" android:gravity="center_vertical">
        <TextView android:id="@+id/t_row2_k" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="10sp" android:layout_marginEnd="6dp" />
        <TextView android:id="@+id/t_row2_w" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="11sp" android:textStyle="bold" android:layout_marginEnd="8dp" />
        <TextView android:id="@+id/t_row2_t" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
            android:textSize="12sp" android:textColor="#3A4354" android:maxLines="1" android:ellipsize="end" />
    </LinearLayout>
    <LinearLayout android:id="@+id/t_row3" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:layout_marginTop="4dp" android:paddingStart="10dp" android:paddingEnd="10dp"
        android:paddingTop="5dp" android:paddingBottom="5dp" android:background="@drawable/widget_row_bg" android:gravity="center_vertical">
        <TextView android:id="@+id/t_row3_k" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="10sp" android:layout_marginEnd="6dp" />
        <TextView android:id="@+id/t_row3_w" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="11sp" android:textStyle="bold" android:layout_marginEnd="8dp" />
        <TextView android:id="@+id/t_row3_t" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
            android:textSize="12sp" android:textColor="#3A4354" android:maxLines="1" android:ellipsize="end" />
    </LinearLayout>
    <LinearLayout android:id="@+id/t_row4" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:layout_marginTop="4dp" android:paddingStart="10dp" android:paddingEnd="10dp"
        android:paddingTop="5dp" android:paddingBottom="5dp" android:background="@drawable/widget_row_bg" android:gravity="center_vertical">
        <TextView android:id="@+id/t_row4_k" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="10sp" android:layout_marginEnd="6dp" />
        <TextView android:id="@+id/t_row4_w" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="11sp" android:textStyle="bold" android:layout_marginEnd="8dp" />
        <TextView android:id="@+id/t_row4_t" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
            android:textSize="12sp" android:textColor="#3A4354" android:maxLines="1" android:ellipsize="end" />
    </LinearLayout>
</LinearLayout>
