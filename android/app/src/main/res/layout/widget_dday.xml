<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/w_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="12dp"
    android:background="@drawable/widget_bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <ImageView
            android:id="@+id/w_char"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:layout_marginEnd="10dp"
            android:scaleType="fitCenter"
            android:contentDescription="캐릭터" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView android:id="@+id/w_label" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="다음 기념일" android:textSize="11sp" android:textColor="#7A8494" android:textStyle="bold" />
            <TextView android:id="@+id/w_title" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="" android:textSize="14sp" android:textColor="#1B2230" android:textStyle="bold" android:maxLines="1" android:ellipsize="end" />
            <TextView android:id="@+id/w_dd" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="D-0" android:textSize="28sp" android:textColor="#4F7CFF" android:textStyle="bold" android:includeFontPadding="false" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout android:id="@+id/w_row1" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:layout_marginTop="6dp" android:paddingStart="10dp" android:paddingEnd="10dp"
        android:paddingTop="5dp" android:paddingBottom="5dp" android:background="@drawable/widget_row_bg" android:gravity="center_vertical">
        <TextView android:id="@+id/w_row1_t" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
            android:textSize="12sp" android:textColor="#3A4354" android:maxLines="1" android:ellipsize="end" />
        <TextView android:id="@+id/w_row1_d" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:textSize="12sp" android:textColor="#4F7CFF" android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout android:id="@+id/w_row2" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:layout_marginTop="4dp" android:paddingStart="10dp" android:paddingEnd="10dp"
        android:paddingTop="5dp" android:paddingBottom="5dp" android:background="@drawable/widget_row_bg" android:gravity="center_vertical">
        <TextView android:id="@+id/w_row2_t" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
            android:textSize="12sp" android:textColor="#3A4354" android:maxLines="1" android:ellipsize="end" />
        <TextView android:id="@+id/w_row2_d" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:textSize="12sp" android:textColor="#4F7CFF" android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
