{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AnniversaryDday",
  "version": "1.0.0",
  "identifier": "com.ppangsal.dday",
  "build": {
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "core",
        "url": "core.html",
        "visible": false,
        "width": 200,
        "height": 200,
        "skipTaskbar": true,
        "focus": false,
        "decorations": false
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$DATA/기념일 D-day/**",
          "$DATA/*/images/**",
          "$DATA/*/sounds/**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "shortDescription": "자캐 기념일 D-day · 바탕화면 캐릭터",
    "publisher": "빵살",
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      },
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "Korean"
        ],
        "displayLanguageSelector": false,
        "installerHooks": "./windows/hooks.nsh",
        "installerIcon": "icons/icon.ico"
      }
    }
  },
  "mainBinaryName": "AnniversaryDday"
}